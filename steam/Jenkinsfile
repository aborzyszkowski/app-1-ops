pipeline {
  agent any
  stages {
        stage('Gracze online') {
            steps {
                powershell '''
                    $ErrorActionPreference = 'Stop'
                    $appid = 570

                    $url = "https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=$appid"
                    $json = Invoke-RestMethod -Uri $url -UseBasicParsing -TimeoutSec 20

                    Write-Output "AppID: $appid (DOTA 2)"
                    Write-Output "Gracze online: $($json.response.player_count)"
                '''
            }
        }
    }
}
